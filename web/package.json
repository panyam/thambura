{
  "name": "thambura-web",
  "private": true,
  "type": "module",
  "description": "Thambura frontend: goapplib page shells + a SolidJS player island over a pure TS engine",
  "scripts": {
    "buildcss": "tailwindcss -i ./tailwind.input.css -o ./static/css/tailwind.css",
    "buildcssprod": "tailwindcss -i ./tailwind.input.css -o ./static/css/tailwind.css --minify",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "render-mix": "node scripts/render-mix.mjs"
  },
  "dependencies": {
    "@panyam/tsappkit": "^0.0.5",
    "@panyam/tsappkit-solid": "^0.0.1",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
